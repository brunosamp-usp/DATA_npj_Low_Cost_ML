&CONTROL
  calculation   = 'scf'
  restart_mode  = 'from_scratch'
  outdir        = './output_vc/'
  pseudo_dir    = './pseudo/'
  prefix        = 'n-ni100-3.0A'
  verbosity     = 'high'
  tstress       = .true.
  tprnfor       = .true.
  etot_conv_thr = 1.0d-6
  forc_conv_thr = 1.0d-4
/

&SYSTEM
  ibrav       = 0
  nat         = 17
  ntyp        = 2
  ecutwfc     = 60
  ecutrho     = 600
  input_dft   = 'RPBE'
  occupations = 'smearing'
  smearing    = 'fermi-dirac'
  degauss     = 0.0036749
  nspin       = 2
  starting_magnetization(1) = 0.5
/

&ELECTRONS
  diagonalization = 'cg'
  conv_thr = 1.0d-6
  electron_maxstep= 800
  mixing_mode     = 'TF'
  mixing_beta     = 0.5
  mixing_ndim     = 20
  diago_thr_init   = 1.0d-4  
/

&IONS
/

&CELL
/

