&CONTROL
   calculation     = 'scf'
   restart_mode    = 'from_scratch'
   wf_collect      = .true.
   outdir          = './output'
   pseudo_dir      = './pseudo'
   prefix          = 'pt-ch3-8'
   verbosity       = 'high'
   forc_conv_thr   = 0.0009723
   nstep           = 100
   tstress         = .true.
   tprnfor         = .true.
 /
 &SYSTEM
   ibrav           = 0
   nat             = 68
   ntyp            = 3
   ecutwfc         = 60
   ecutrho         = 600
   input_dft       = 'RPBE'
   nosym           = .TRUE.
   noinv           = .false.
   nspin = 2
   starting_magnetization(1) = 0.0
   starting_magnetization(2) = 0.5
   starting_magnetization(3) = 0.5
   occupations     = 'smearing'
   degauss         = 0.0036749
   smearing        = "fermi-dirac"
/
 &ELECTRONS
  diagonalization = 'david'
  conv_thr        = 1.0d-6
  electron_maxstep= 200
  mixing_mode     = 'local-TF'
  mixing_beta     = 0.2
  mixing_ndim     = 12
/
&CELL
/
 &IONS
  ion_dynamics = 'bfgs'
/
