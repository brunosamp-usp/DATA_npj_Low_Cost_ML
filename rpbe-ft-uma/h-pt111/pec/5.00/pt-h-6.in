&CONTROL
   calculation     = 'scf'
   restart_mode    = 'from_scratch'
   wf_collect      = .true.
   outdir          = './output'
   pseudo_dir      = './pseudo'
   prefix          = 'pt-h-6'
   verbosity       = 'high'
   forc_conv_thr   = 0.0009723
   nstep           = 100
   tstress         = .true.
   tprnfor         = .true.
/
 &SYSTEM
   ibrav           = 0
   nat             = 17
   ntyp            = 2
   ecutwfc         = 60
   ecutrho         = 600
   input_dft       = 'RPBE'
   nosym           = .TRUE.
   noinv           = .false.
   nspin = 2
   starting_magnetization(1) = 0.0
   starting_magnetization(2) = 1.0
   occupations     = 'smearing'
   degauss         = 0.0036749
   smearing        = "fermi-dirac"
/
 &ELECTRONS
  diagonalization = 'david'
  conv_thr        = 1.0d-5
  electron_maxstep= 1600
  mixing_mode     = 'local-TF'
  mixing_beta     = 0.3
  mixing_ndim     = 12
/
&CELL
/
 &IONS
  ion_dynamics = 'bfgs'
/
