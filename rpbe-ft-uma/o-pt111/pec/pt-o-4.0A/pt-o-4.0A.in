   prefix          = 'pt-o-4p0'
   verbosity       = 'high'
   forc_conv_thr   = 0.0009723
   nstep           = 100
   tstress         = .true.
   tprnfor         = .true.
   dipfield        = .true.
   tefield         = .true.
 /
 &SYSTEM
   ibrav           = 0
   nat             = 37
   ntyp            = 2
   ecutwfc         = 60
   ecutrho         = 600
   edir            = 3
   eamp            = 0.0
